    var type: UInt64
    var destroy: _FnPtr
    var ReadyToRun: _FnPtr
    var MessageReceived: _FnPtr
    var QuitRequested: _FnPtr
    var AboutRequested: _FnPtr
    var Pulse: _FnPtr

    def __init__(out self):
        self.type = 0
        self.destroy = {}
        self.ReadyToRun = {}
        self.MessageReceived = {}
        self.QuitRequested = {}
        self.AboutRequested = {}
        self.Pulse = {}


