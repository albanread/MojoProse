struct BMessageRef(
    Boolable,
    ImplicitlyCopyable,
    RegisterPassable,
    _BMessageMethods,
):
    """A `BMessage` the kit owns: valid in a hook, or while its looper is locked. It may be NULL: test it with `if`."""

    var _ptr: _NPtr
    var what: UInt32
    """`BMessage::what`, read when the reference was made."""

    def __init__(out self):
        """A NULL reference."""
        self._ptr = None
        self.what = 0

    def __init__(out self, ptr: _NPtr):
        self._ptr = ptr
        self.what = external_call["mojobe_BMessage_get_what", UInt32](
            _addr(ptr),
        ) if ptr else 0

    def __bool__(self) -> Bool:
        return Bool(self._ptr)

    def _as_BMessage(self) -> _NPtr:
        return self._ptr


struct BMessage(Movable, _BMessageMethods):
    """A `BMessage` Mojo owns, until something adopts it."""

    var _ptr: _NPtr

    def __init__(out self) raises:
        """`BMessage::BMessage()`."""
        var address = external_call["mojobe_BMessage_new__void", Int]()
        if address == 0:
            raise Error("BMessage could not be made")
        self._ptr = _ptr_from(address)

    def __init__(out self, what: UInt32) raises:
        """`BMessage::BMessage(uint32 what)`."""
        var address = external_call["mojobe_BMessage_new__uint32", Int](what)
        if address == 0:
            raise Error("BMessage could not be made")
        self._ptr = _ptr_from(address)

    def __deinit__(deinit self):
        external_call["mojobe_BMessage_delete", NoneType](_addr(self._ptr))

    def _adopt(deinit self) -> Int:
        """Hands the object over without deleting it."""
        return _addr(self._ptr)

    def _as_BMessage(self) -> _NPtr:
        return self._ptr

