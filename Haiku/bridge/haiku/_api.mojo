    hooks.type = _type_tag[T]()
    hooks.destroy = _fn_ptr(_destroy[T])
    comptime if conforms_to(T, HandlerMessageReceived):
        hooks.MessageReceived = _fn_ptr(
            _BHandler_MessageReceived[downcast[T, HandlerMessageReceived]],
        )
    return hooks

