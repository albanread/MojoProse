def _BWindow_hooks[T: Movable & Deinitable]() -> _BWindowHooks:
    """`T`'s hooks for a `BWindow`: a slot for each hook it implements, NULL for the rest, decided at compile time."""
    var hooks = _BWindowHooks()
    hooks.type = _type_tag[T]()
    hooks.destroy = _fn_ptr(_destroy[T])
    comptime if conforms_to(T, WindowMessageReceived):
        hooks.MessageReceived = _fn_ptr(
            _BWindow_MessageReceived[downcast[T, WindowMessageReceived]],
        )
    comptime if conforms_to(T, WindowQuitRequested):
        hooks.QuitRequested = _fn_ptr(
            _BWindow_QuitRequested[downcast[T, WindowQuitRequested]],
        )
    comptime if conforms_to(T, WindowFrameMoved):
        hooks.FrameMoved = _fn_ptr(
            _BWindow_FrameMoved[downcast[T, WindowFrameMoved]],
        )
    comptime if conforms_to(T, WindowFrameResized):
        hooks.FrameResized = _fn_ptr(
            _BWindow_FrameResized[downcast[T, WindowFrameResized]],
        )
    comptime if conforms_to(T, WindowWindowActivated):
        hooks.WindowActivated = _fn_ptr(
            _BWindow_WindowActivated[downcast[T, WindowWindowActivated]],
        )
    comptime if conforms_to(T, WindowWorkspaceActivated):
        hooks.WorkspaceActivated = _fn_ptr(
            _BWindow_WorkspaceActivated[downcast[T, WindowWorkspaceActivated]],
        )
    comptime if conforms_to(T, WindowMenusBeginning):
        hooks.MenusBeginning = _fn_ptr(
            _BWindow_MenusBeginning[downcast[T, WindowMenusBeginning]],
        )
    comptime if conforms_to(T, WindowMenusEnded):
        hooks.MenusEnded = _fn_ptr(
            _BWindow_MenusEnded[downcast[T, WindowMenusEnded]],
        )
    comptime if conforms_to(T, WindowZoom):
        hooks.Zoom = _fn_ptr(_BWindow_Zoom[downcast[T, WindowZoom]])
    comptime if conforms_to(T, WindowMinimize):
        hooks.Minimize = _fn_ptr(_BWindow_Minimize[downcast[T, WindowMinimize]])
    return hooks

