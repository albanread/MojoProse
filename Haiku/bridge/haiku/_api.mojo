def _BApplication_hooks[T: Movable & Deinitable]() -> _BApplicationHooks:
    """`T`'s hooks for a `BApplication`: a slot for each hook it implements, NULL for the rest, decided at compile time."""
    var hooks = _BApplicationHooks()
    hooks.type = _type_tag[T]()
    hooks.destroy = _fn_ptr(_destroy[T])
    comptime if conforms_to(T, ApplicationReadyToRun):
        hooks.ReadyToRun = _fn_ptr(
            _BApplication_ReadyToRun[downcast[T, ApplicationReadyToRun]],
        )
    comptime if conforms_to(T, ApplicationMessageReceived):
        hooks.MessageReceived = _fn_ptr(
            _BApplication_MessageReceived[downcast[T, ApplicationMessageReceived]],
        )
    comptime if conforms_to(T, ApplicationQuitRequested):
        hooks.QuitRequested = _fn_ptr(
            _BApplication_QuitRequested[downcast[T, ApplicationQuitRequested]],
        )
    comptime if conforms_to(T, ApplicationAboutRequested):
        hooks.AboutRequested = _fn_ptr(
            _BApplication_AboutRequested[downcast[T, ApplicationAboutRequested]],
        )
    comptime if conforms_to(T, ApplicationPulse):
        hooks.Pulse = _fn_ptr(
            _BApplication_Pulse[downcast[T, ApplicationPulse]],
        )
