+#elif defined(__HAIKU__) && defined(__aarch64__)
+StringRef sys::getHostCPUName() {
+  // Haiku reports each core's MIDR_EL1 as its topology node's model.
+  uint32 Count = 0;
+  if (get_cpu_topology_info(nullptr, &Count) != B_OK || Count == 0)
+    return "generic";
+  std::vector<cpu_topology_node_info> Nodes(Count);
+  if (get_cpu_topology_info(Nodes.data(), &Count) != B_OK)
+    return "generic";
+
+  SmallVector<uint64_t> Values;
+  uint64_t PrimaryCpuInfo = 0;
+  for (uint32 I = 0; I < Count; ++I) {
+    if (Nodes[I].type != B_TOPOLOGY_CORE)
+      continue;
+    // The last core is the primary one, as the last "CPU part" line of
+    // /proc/cpuinfo is on Linux.
+    PrimaryCpuInfo = Nodes[I].data.core.model;
+    if (!llvm::is_contained(Values, PrimaryCpuInfo))
+      Values.push_back(PrimaryCpuInfo);
+  }
+  if (Values.empty())
+    return "generic";
+  llvm::sort(Values);
+
+  StringRef Name = detail::getHostCPUNameForARM(PrimaryCpuInfo, Values);
+
+  // Apple's hypervisor shows its guests Apple's implementer code with the
+  // part number cleared (MIDR_EL1 0x610f0000), so no table can name the
+  // processor. Every Apple processor is an M1 or later.
+  if (Name == "generic" && ((PrimaryCpuInfo >> 24) & 0xff) == 0x61)
+    return "apple-m1";
+  return Name;
+}
