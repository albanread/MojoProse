+# Haiku: what LLVM's CMake finds there. Everything below is in libroot. Haiku
+# has no getauxval, mallinfo or execinfo backtrace (which posix_defines claims
+# for every POSIX system); _GNU_SOURCE makes Haiku's gnu/pthread.h declare
+# pthread_{get,set}name_np.
+haiku_defines = [
+    define
+    for define in posix_so_defines
+    if not define.startswith("HAVE_BACKTRACE") and not define.startswith("BACKTRACE_HEADER")
+] + [
+    "_GNU_SOURCE",
+    "HAVE_SBRK=1",
+    "HAVE_STRUCT_STAT_ST_MTIM_TV_NSEC=1",
+]
+
