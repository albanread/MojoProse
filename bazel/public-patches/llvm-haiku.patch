+# Haiku: what LLVM's CMake finds there. Everything below is in libroot. Haiku
+# has no getauxval, mallinfo or execinfo backtrace (which posix_defines claims
+# for every POSIX system); _GNU_SOURCE makes Haiku's gnu/pthread.h declare
+# pthread_{get,set}name_np.
+haiku_defines = [
+    define
+    for define in posix_so_defines
+    if not define.startswith("HAVE_BACKTRACE") and not define.startswith("BACKTRACE_HEADER")
+] + [
+    "_GNU_SOURCE",
+    "HAVE_SBRK=1",
+    "HAVE_STRUCT_STAT_ST_MTIM_TV_NSEC=1",
+]
+
 arc4random_defines = select({
     "@platforms//os:macos": ["HAVE_DECL_ARC4RANDOM=1"],
     "//conditions:default": ["HAVE_DECL_ARC4RANDOM=0"],
@@ -115,6 +129,7 @@
 os_defines = select({
     "@platforms//os:emscripten": emscripten_defines,
     "@platforms//os:freebsd": posix_so_defines,
+    "@platforms//os:haiku": haiku_defines,
     "@platforms//os:macos": macos_defines,
     "@platforms//os:windows": win32_defines,
     "//conditions:default": linux_defines,
@@ -148,6 +163,7 @@
